# 模型网关 API 配置（OpenAI 兼容端点）
# 复制为 .env 并填入真实 API 密钥

# Stage 1 主路 VLM（视觉转译与求解）
VLM_PRIMARY_BASE_URL=https://api.openai.com/v1
VLM_PRIMARY_API_KEY=
VLM_PRIMARY_MODEL=gemini-2.5-pro

# Stage 1 辅路 VLM（跨模型家族独立双盲）
VLM_SECONDARY_BASE_URL=https://api.openai.com/v1
VLM_SECONDARY_API_KEY=
VLM_SECONDARY_MODEL=claude-3-7-sonnet

# Stage 2 纯文本深度拆解与正交打标
TEXT_LLM_BASE_URL=https://api.openai.com/v1
TEXT_LLM_API_KEY=
TEXT_LLM_MODEL=deepseek-chat

# 裁判模型（可选独立配置；留空时自动回退复用 TEXT_LLM 且 temperature=0.0）
JUDGE_LLM_BASE_URL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=

# 本地/云端向量嵌入模型
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
